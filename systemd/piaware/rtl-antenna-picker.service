[Unit]
Description=RTL-SDR antenna-characteristics selector for ADS-B/AIS roles
Documentation=https://github.com/Komzpa/rtl-antenna-picker
Wants=systemd-udev-settle.service
After=local-fs.target systemd-udev-settle.service
Before=dump1090-fa.service ais-rtl-tcp.service

[Service]
Type=oneshot
# --learn: remember roles by USB serial, never fail on an ambiguous fingerprint;
# rtl-antenna-picker-verify.timer corrects the guess from decoded traffic.
# Host-specific extras go to RTL_ANTENNA_PICKER_ARGS.
EnvironmentFile=-/etc/default/rtl-antenna-picker
ExecStart=@RTL_ANTENNA_PICKER@ --output-env /run/rtl-antenna-picker.env --state-dir /var/lib/rtl-antenna-picker --apply-piaware --print-json --learn $RTL_ANTENNA_PICKER_ARGS
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
